NVIDIA_API_KEY=NVIDIA_API_KEY
NVIDIA_MODEL=openai/gpt-oss-20b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_FOLLOWUP_TIMEOUT_SECONDS=15
CORS_ORIGINS=http://localhost:5173

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace_with_a_random_secret
DATABASE_URL=sqlite:///./pcos_agent.sqlite3
# For Turso, set DATABASE_URL=libsql://<your-database-host> and provide a
# database auth token as TURSO_AUTH_TOKEN. Never expose this token in the frontend.
TURSO_AUTH_TOKEN=
JWT_EXPIRE_MINUTES=60
ADMIN_API_KEY=replace_with_a_long_random_admin_key

# Optional registration notifications. SMTP_APP_PASSWORD must be a Gmail App Password.
SMTP_USER=your-account@gmail.com
SMTP_APP_PASSWORD=your-gmail-app-password
ADMIN_NOTIFY_EMAIL=admin@example.com

# Options: magpie (NVIDIA hosted Magpie), edge, or browser. Magpie uses NVIDIA_API_KEY.
TTS_PROVIDER=magpie
EDGE_TTS_VOICE=en-IN-NeerjaNeural
MAGPIE_TTS_URL=https://877104f7-e885-42b9-8de8-f6e4c6303969.invocation.api.nvcf.nvidia.com/v1/audio/synthesize
MAGPIE_TTS_VOICE=Magpie-Multilingual.EN-US.Aria

# Optional contact in the descriptive Nominatim User-Agent; use a real project email.
OSM_CONTACT_EMAIL=
